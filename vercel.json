{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api?path=/" },
    { "source": "/week", "destination": "/api?path=/week" },
    { "source": "/trajectory", "destination": "/api?path=/trajectory" },
    { "source": "/actions/refresh", "destination": "/api?path=/actions/refresh" }
  ]
}
