# Supabase connection string. Host prefix (aws-0 vs aws-1 etc.) and port vary per
# project/region — copy the exact pooler string from Database Settings > Connection
# Pooling in the dashboard rather than guessing. Works with either the session
# pooler (5432) or transaction pooler (6543) since the client sets prepare:false.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:<port>/postgres

# Strava API app (create at strava.com/settings/api). Client ID isn't secret;
# Client Secret is. Run `npm run strava:auth` once to fill in the rest via OAuth.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
STRAVA_ATHLETE_ID=

# Athlete/coaching configuration. Days use 0=Monday … 6=Sunday.
# Leave ATHLETE_GYM_DAYS empty to infer recurring strength days from the last 120 days.
ATHLETE_HR_REST=55
ATHLETE_GYM_DAYS=
# Strava does not say whether a generic weight-training activity was legs/upper/full.
# Configure the days that create meaningful lower-body fatigue so the coach can space runs.
ATHLETE_LOWER_BODY_DAYS=

# Dashboard-local calendar boundaries (fitness days, plan weeks, compliance).
DASHBOARD_TZ=America/Bogota
